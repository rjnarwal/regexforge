{
  "name": "regexforge",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "RegexForge - Real-Time Regular Expression Visualizer, Parser, Tester & Multi-Language Code Generator",
  "author": {
    "name": "Rajesh Narwal",
    "email": "rajesh@grassroot.digital",
    "url": "https://grassroot.digital"
  },
  "homepage": "https://regexforge.grassroot.digital",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:mac": "npm run build && electron-builder --mac",
    "build:win": "npm run build && electron-builder --win",
    "preview": "vite preview"
  },
  "build": {
    "appId": "digital.grassroot.regexforge",
    "productName": "RegexForge",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "icon": "electron/icon.icns",
      "target": ["dmg", "zip"]
    },
    "win": {
      "icon": "electron/icon.png",
      "target": ["nsis", "portable"]
    },
    "linux": {
      "icon": "electron/icon.png",
      "category": "Development",
      "maintainer": "Rajesh Narwal <rajesh@grassroot.digital>",
      "target": ["AppImage", "deb"]
    }
  },
  "dependencies": {
    "clsx": "^2.1.0",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.2.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.2.2",
    "vite": "^5.1.4"
  }
}
